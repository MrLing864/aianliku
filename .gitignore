# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules_node16_bak/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.screenshots/
/test-results/
/playwright-report/

# next.js
/.next/
/.next-stale-*/
/.next-broken-*/
/.dependency-stale-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
dev.log
dev.err.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# edgeone
.edgeone

# local script run logs
scripts/insert-run.log

# local reports (large pdf assets, not part of app deploy)
/report

# playwright-cli local cache/logs
/.playwright-cli/

# script run logs
/scripts/logs/

# typescript
*.tsbuildinfo
next-env.d.ts
/.swc

# codebuddy integration local credentials/config (not project source)
.codebuddy/integration/

# OCR run reports (intermediate text artifacts, not part of app/deploy)
/report_ocr_run3/

# generated case JSON (regenerated by scripts, not version-controlled)
/cases_json/

# SSL certificates (never commit to Git)
/aianliku.com_nginx/
